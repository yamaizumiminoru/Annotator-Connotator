{
  "version": 1,
  "languages": ["ja", "en"],
  "categories": [
    "evaluative",
    "stance",
    "politeness",
    "implicature",
    "presupposition",
    "register",
    "irony",
    "euphemism"
  ],
  "cases": [
    {
      "id": "ja-evaluative-clear",
      "language": "ja",
      "category": "evaluative",
      "pattern": "clear",
      "sourceText": "その説明は子供っぽくて、説得力に欠ける。",
      "targetText": "子供っぽくて",
      "expected": {
        "shouldDetect": true,
        "acceptableCategories": ["evaluative"],
        "requiredIdeas": ["childish rather than merely childlike", "negative evaluation"],
        "forbiddenClaims": ["literal age of the speaker", "hostility"],
        "contextDependency": "low"
      }
    },
    {
      "id": "en-evaluative-contrast",
      "language": "en",
      "category": "evaluative",
      "pattern": "contrast",
      "sourceText": "The columnist described the actor as skinny in an otherwise admiring profile.",
      "targetText": "skinny",
      "expected": {
        "shouldDetect": true,
        "acceptableCategories": ["evaluative"],
        "requiredIdeas": ["often less positive than slim", "can suggest unattractive or excessive thinness"],
        "forbiddenClaims": ["medical diagnosis", "deliberate insult as a certainty"],
        "contextDependency": "medium"
      }
    },
    {
      "id": "ja-evaluative-context",
      "language": "ja",
      "category": "evaluative",
      "pattern": "context",
      "sourceText": "この子供っぽい色使いが、むしろ作品の魅力だ。",
      "targetText": "子供っぽい",
      "expected": {
        "shouldDetect": true,
        "acceptableCategories": ["evaluative"],
        "requiredIdeas": ["usually risks a negative evaluation", "the context positively reframes it as charm"],
        "forbiddenClaims": ["unambiguously negative in this sentence"],
        "contextDependency": "high"
      }
    },
    {
      "id": "en-evaluative-negative",
      "language": "en",
