    {
      "id": "en-politeness-positive",
      "language": "en",
      "category": "politeness",
      "pattern": "clear",
      "sourceText": "Come on, you're one of us. Sit with us and tell us what happened.",
      "targetText": "you're one of us",
      "expected": {
        "shouldDetect": true,
        "acceptableCategories": ["politeness", "register"],
        "requiredIdeas": ["solidarity", "closeness or inclusion"],
        "forbiddenClaims": ["coercion as a certainty", "formal deference"],
        "contextDependency": "medium"
      }
    },
    {
      "id": "ja-politeness-contrast",
      "language": "ja",
      "category": "politeness",
      "pattern": "contrast",
      "sourceText": "受付では「恐れ入りますが、こちらにご記入いただけますでしょうか」と案内し、休憩中は同僚に「ここ書いて」と頼んだ。",
      "targetText": "恐れ入りますが",
      "expected": {
        "shouldDetect": true,
        "acceptableCategories": ["politeness", "register"],
        "requiredIdeas": ["deference", "acknowledges burden before a request", "contrasts with the later casual request"],
        "forbiddenClaims": ["fear in the literal emotional sense", "hostility"],
        "contextDependency": "low"
      }
    },
    {
      "id": "ja-politeness-context",
      "language": "ja",
      "category": "politeness",
      "pattern": "context",
      "sourceText": "担当者は「検討しておきます。金曜日までに費用を比較して回答します」と答えた。",
      "targetText": "検討しておきます",
      "expected": {
        "shouldDetect": true,
        "acceptableCategories": ["politeness", "implicature"],
        "requiredIdeas": ["can sometimes avoid commitment", "the concrete follow-up plan supports a literal commitment here"],
        "forbiddenClaims": ["definite rejection", "no action will occur"],
        "contextDependency": "high"
      }
    },
