        "forbiddenClaims": ["approval", "disapproval", "emotional distance"],
        "contextDependency": "low"
      }
    },
    {
      "id": "en-stance-clear",
      "language": "en",
      "category": "stance",
      "pattern": "clear",
      "sourceText": "Apparently, the committee has already reached a decision.",
      "targetText": "Apparently",
      "expected": {
        "shouldDetect": true,
        "acceptableCategories": ["stance"],
        "requiredIdeas": ["the speaker presents the information as indirect or not fully personally guaranteed"],
        "forbiddenClaims": ["the information is false", "sarcasm"],
        "contextDependency": "medium"
      }
    },
    {
      "id": "ja-stance-context",
      "language": "ja",
      "category": "stance",
      "pattern": "context",
      "sourceText": "正直なところ、その案にはまだ納得していません。",
      "targetText": "正直なところ",
      "expected": {
        "shouldDetect": true,
        "acceptableCategories": ["stance"],
        "requiredIdeas": ["signals candor", "prepares the listener for a potentially unwelcome opinion"],
        "forbiddenClaims": ["the speaker was previously lying"],
        "contextDependency": "medium"
      }
    },
    {
      "id": "en-stance-contrast",
      "language": "en",
      "category": "stance",
      "pattern": "contrast",
      "sourceText": "Apparently, the door was unlocked; I later checked it myself and confirmed that it was.",
      "targetText": "Apparently",
      "expected": {
        "shouldDetect": true,
        "acceptableCategories": ["stance"],
        "requiredIdeas": ["initially marks indirect evidence", "later personal confirmation changes the evidential situation"],
        "forbiddenClaims": ["the final claim remains merely hearsay"],
        "contextDependency": "high"
      }
    },
