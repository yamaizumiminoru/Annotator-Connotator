    {
      "id": "en-implicature-clear",
      "language": "en",
      "category": "implicature",
      "pattern": "clear",
      "sourceText": "Some students passed the exam.",
      "targetText": "Some students passed",
      "expected": {
        "shouldDetect": true,
        "acceptableCategories": ["implicature"],
        "requiredIdeas": ["often suggests not all", "not all is not logically entailed"],
        "forbiddenClaims": ["proves that some students failed"],
        "contextDependency": "high"
      }
    },
    {
      "id": "ja-implicature-context",
      "language": "ja",
      "category": "implicature",
      "pattern": "context",
      "sourceText": "「もう一軒行きませんか」と誘われて、彼女は時計を見ながら「もう遅いですよ」と答えた。",
      "targetText": "もう遅いですよ",
      "expected": {
        "shouldDetect": true,
        "acceptableCategories": ["implicature", "politeness"],
        "requiredIdeas": ["contextually functions as declining the invitation", "the refusal is indirect"],
        "forbiddenClaims": ["the sentence literally says I refuse", "anger"],
        "contextDependency": "high"
      }
    },
    {
      "id": "en-implicature-cancellation",
      "language": "en",
      "category": "implicature",
      "pattern": "contrast",
      "sourceText": "Some students passed the exam. In fact, all of them did.",
      "targetText": "Some students passed the exam",
      "expected": {
        "shouldDetect": true,
        "acceptableCategories": ["implicature"],
        "requiredIdeas": ["the usual not-all inference is explicitly cancelled", "the two sentences are not logically contradictory"],
        "forbiddenClaims": ["some students failed", "contradiction"],
        "contextDependency": "high"
      }
    },
